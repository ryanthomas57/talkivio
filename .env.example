# Talkivio environment reference. Copy to `.env` for local development WITHOUT Docker:
#   cp .env.example .env
# Every value here is a LOCAL placeholder. Never commit real secrets; outside local development inject
# secrets from a secret manager (docs/operations/deployment.md). Lines starting with # are optional
# settings shown with an example value; uncomment to use them. Keep one KEY=VALUE per line, no inline comments.
# docker compose does NOT read this file for services (it has its own local defaults, see docker-compose.yml);
# the compose `seed` job reads only the SEED_* values below.

# ─────────────────────────── Process ───────────────────────────
NODE_ENV=development
# HTTP port of the api process (dist/main.js)
PORT=4000
HOST=0.0.0.0
# true = api serves REST only; sockets run in the separate gateway process (dist/gateway.js)
GATEWAY_SEPARATE=false
GATEWAY_PORT=4001
# Port probed by the container HEALTHCHECK (gateway role: 4001). Defaults to PORT.
# HEALTHCHECK_PORT=4001
# TALKIVIO_PROCESS (api|gateway|worker|replay) is set by each entrypoint itself for logs/traces — do not set it.
# Run worker loops inside the api process (single-process dev only; production runs dist/worker.js)
RUN_WORKERS_IN_API=false
# Directory with the built widget (loader.js, frame/*). Default: apps/widget/dist relative to the api build.
# WIDGET_DIST_DIR=/app/widget-dist

# ─────────────────────────── Public URLs & HTTP ───────────────────────────
BRAND_NAME=Talkivio
# Public base URL of the API (widget asset URLs, file links, OAuth callbacks)
API_URL=http://localhost:4000
# Public base URL of the dashboard (email links, CORS, socket Origin allowlist)
APP_URL=http://localhost:3000
# Widget assets base URL (CDN). Default: API_URL/widget
# WIDGET_CDN_URL=https://cdn.example.com/talkivio/widget
# Comma-separated dashboard origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy": loopback | uniquelocal | true | <hop count>. Behind a proxy on a private network use uniquelocal.
TRUST_PROXY=loopback
# Cookie domain for multi-subdomain deployments (leave unset for host-only cookies)
# COOKIE_DOMAIN=example.com
# Secure cookies: must be true whenever the dashboard is served over HTTPS
COOKIE_SECURE=false

# ─────────────────────────── Database (docs/adr/0002) ───────────────────────────
# Application role: RLS-bound, no BYPASSRLS, DML only. Used by api, gateway, worker and seed.
DATABASE_URL=postgresql://talkivio_app:talkivio_app_dev_password@localhost:5432/talkivio_dev?schema=public
# Owner role: migrations and db-reset only. Never give this to running services.
DATABASE_OWNER_URL=postgresql://postgres@localhost:5432/talkivio_dev?schema=public
# Log every SQL statement (debug only; may log identifiers)
# PRISMA_LOG=query

# ─────────────────────────── Redis ───────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─────────────────────────── Secrets ───────────────────────────
# >= 32 characters. Encrypts secrets at rest and keys HMACs. Generate: openssl rand -base64 48
APP_SECRET=local-dev-only-app-secret-0123456789abcdef0123456789

# ─────────────────────────── Email ───────────────────────────
# console = print emails to the log (they are still stored in outbound_emails); smtp = deliver (Mailpit locally)
EMAIL_PROVIDER=console
EMAIL_FROM="Talkivio <no-reply@talkivio.local>"
# Mailpit: docker compose up mailpit (UI http://localhost:8025, SMTP 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=talkivio
# SMTP_PASSWORD=local-dev-only-smtp-password
SMTP_SECURE=false

# ─────────────────────────── Object storage ───────────────────────────
# local = files under STORAGE_LOCAL_DIR (dev only); s3 = any S3-compatible store (MinIO locally)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=talkivio-app
# S3_SECRET_ACCESS_KEY=local-dev-only-s3-app-secret
# Default bucket (fallback for the two below)
# S3_BUCKET=talkivio-clean
# Private bucket for untrusted uploads before scanning (never served)
# S3_QUARANTINE_BUCKET=talkivio-quarantine
# Private bucket for clean files and export artifacts
# S3_CLEAN_BUCKET=talkivio-clean
# true for MinIO / path-style endpoints
S3_FORCE_PATH_STYLE=true
S3_QUARANTINE_PREFIX=quarantine/
S3_CLEAN_PREFIX=clean/
S3_EXPORTS_PREFIX=exports/
# Browser-reachable endpoint used only when signing URLs (upload PUTs always; GETs in presigned mode) when the
# API reaches the store on another host (Compose: http://localhost:9000, the API dials minio:9000)
# S3_PRESIGN_ENDPOINT=http://localhost:9000
# presigned = short presigned GET from the bucket; proxy = stream through the API with nosniff/CSP headers
S3_DOWNLOAD_MODE=presigned

# ─────────────────────────── File scanning (ch. 19) ───────────────────────────
# clamav = scan with clamd (uploads stay unavailable until clean); dev_unscanned = NO malware scan (refused in production)
SCAN_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
UPLOAD_DAILY_QUOTA_MB=2048
UPLOAD_DAILY_QUOTA_FILES=5000

# ─────────────────────────── Optional: OAuth sign-in ───────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─────────────────────────── Optional: billing (not included in this release) ───────────────────────────
# Reserved for a future billing module (ch. 57). Nothing reads these yet: setting them enables nothing.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_TEAM=price_replace_me
# STRIPE_PRICE_BUSINESS=price_replace_me

# ─────────────────────────── Optional: geo enrichment ───────────────────────────
# Visitor locations: a MaxMind-format database, e.g. DB-IP "IP to City Lite" (free, CC BY 4.0, monthly:
# https://download.db-ip.com/free/dbip-city-lite-YYYY-MM.mmdb.gz) or MaxMind GeoLite2-City. Reloaded when the file changes.
# GEOIP_DB_PATH=/data/dbip-city-lite.mmdb
# Location headers are trusted only from the edge named here: cloudflare, vercel, fastly or proxy (default none).
# GEO_TRUSTED_HEADERS=none
# Development only (ignored in production): the public IP looked up for localhost visitors, so local tests show a location.
# GEO_DEV_IP=

# ─────────────────────────── Observability ───────────────────────────
LOG_LEVEL=info
# SENTRY_DSN=https://public-key@sentry.example.com/1
# SENTRY_TRACES_SAMPLE_RATE=0
# OTLP/HTTP traces (scrubbed of content and personal data before export; see infra/observability/README.md).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─────────────────────────── Realtime tuning ───────────────────────────
VISITOR_HEARTBEAT_MS=15000
VISITOR_TIMEOUT_MS=45000
AGENT_TIMEOUT_MS=45000

# ─────────────────────────── Feature settings (read directly by feature modules) ───────────────────────────
# Webhooks (apps/api/src/features/integrations/config.ts)
# Local webhook TEST PATH ONLY (docker compose enables it for infra/webhook-receiver): allow private/loopback
# webhook targets matching the host list below. Never set in production (the code ignores it there).
TALKIVIO_WEBHOOK_ALLOW_PRIVATE=false
# TALKIVIO_WEBHOOK_ALLOW_PRIVATE_HOSTS=127.0.0.1,localhost,::1
# TALKIVIO_WEBHOOK_RETRY_SCHEDULE_MS=0,10000,60000
# TALKIVIO_WEBHOOK_TIMEOUT_MS=10000
# TALKIVIO_WEBHOOK_ROTATION_OVERLAP_MINUTES=60
# Privacy and retention (apps/api/src/features/privacy/config.ts)
# TALKIVIO_ERASURE_TRANSCRIPT_POLICY=subject_chats
# TALKIVIO_ACCESS_EXPORT_INCLUDE_NOTES=false
# TALKIVIO_PRIVACY_EXPORT_TTL_DAYS=7
# TALKIVIO_PROOF_RETENTION_DAYS=30
# TALKIVIO_RETENTION_BATCH=200
# TALKIVIO_RETENTION_INTERVAL_MINUTES=10
# TALKIVIO_WEBHOOK_DELIVERY_RETENTION_DAYS=30

# ─────────────────────────── Dashboard (apps/dashboard) ───────────────────────────
# Server-side rewrite target for /api/v1/* (evaluated at `next build` time)
API_INTERNAL_URL=http://localhost:4000
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put secrets in them.
NEXT_PUBLIC_BRAND_NAME=Talkivio
# Socket.IO origin for the dashboard. Unset = same origin (correct behind the reverse proxy).
# Running `next dev` on :3000 without the proxy: point it at the api/gateway.
# NEXT_PUBLIC_REALTIME_ORIGIN=http://localhost:4000

# ─────────────────────────── Demo fixtures (apps/api/src/seed.ts) ───────────────────────────
# LOCAL ONLY. The seed refuses NODE_ENV=production; change these for any shared environment.
SEED_DEMO_PASSWORD=talkivio-local-demo-2026
SEED_ALPHA_SITE_KEY=rds_AlphaLocalDemo0001
SEED_BETA_SITE_KEY=rds_BetaLocalDemo00001
# Base URL printed in the seed summary (defaults to API_URL)
# SEED_PUBLIC_BASE_URL=http://localhost:8080
# Alternative file to read SEED_* from (docker compose mounts .env.example here)
# SEED_ENV_FILE=/run/talkivio/seed.env

# ─────────────────────────── docker compose overrides (shell or git-ignored .env) ───────────────────────────
# RD_HTTP_PORT=8080
# RD_POSTGRES_PORT=55432
# RD_LOG_LEVEL=info
# RD_APP_SECRET=local-dev-only-app-secret-0123456789abcdef0123456789
# RD_POSTGRES_SUPERUSER_PASSWORD=local-dev-only-postgres
# RD_OWNER_DB_PASSWORD=local-dev-only-owner-db
# RD_APP_DB_PASSWORD=local-dev-only-app-db
# RD_REDIS_PASSWORD=local-dev-only-redis
# RD_MINIO_ROOT_USER=talkivio-minio-root
# RD_MINIO_ROOT_PASSWORD=local-dev-only-minio-root
# RD_S3_APP_ACCESS_KEY=talkivio-app
# RD_S3_APP_SECRET_KEY=local-dev-only-s3-app-secret
# RD_WEBHOOK_CONTROL_TOKEN=local-dev-only-webhook-control
