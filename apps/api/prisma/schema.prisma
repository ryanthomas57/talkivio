/// Erasure ledger replayed after backup restore (ch. 53). Pseudonymous subject hashes only.
model SubjectTombstone {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  subjectHash      String   @map("subject_hash")
  erasureRequestId String   @map("erasure_request_id") @db.Uuid
  erasedAt         DateTime @default(now()) @map("erased_at") @db.Timestamptz(3)

  @@index([tenantId, subjectHash])
  @@map("subject_tombstones")
}

/// Record of a destroyed tenant (ch. 41 tenant deletion). Deliberately NOT tenant-owned: no
/// tenant FK (it outlives the cascade) and no RLS. No personal data: the tenant id, an HMAC of
/// the slug, the deletion job id, timestamps and row/object counts only.
model TenantTombstone {
  tenantId      String    @id @map("tenant_id") @db.Uuid
  slugHash      String    @map("slug_hash")
  deletionJobId String    @map("deletion_job_id") @db.Uuid
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  /// Set in the same transaction that removes the tenant's rows.
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Set once the post-delete object-storage and Redis passes confirmed nothing remains.
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  counts        Json      @default("{}")

  @@index([completedAt])
  @@map("tenant_tombstones")
}

