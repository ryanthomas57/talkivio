// Talkivio — database schema (Prisma mirror of the SQL migrations).
// Authority: apps/api/prisma/migrations/*.sql (see docs/adr/0002). Tenant-owned
// tables carry tenant_id and are protected by row level security.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enumerations ───────────────────────────

enum Role {
  owner
  admin
  supervisor
  agent
  analyst
}

enum DesiredStatus {
  online
  away
  invisible
}

enum TenantStatus {
  active
  suspended
  deleting
}

enum TokenPurpose {
  verify
  reset
  invite
  recovery
  oauth_state
  mfa_challenge
}

enum RoutingMode {
  manual
  broadcast
  assigned
}

enum ChatStatus {
  queued
  offered
  active
  closed
}

enum ParticipantRole {
  primary
  collaborator
  visitor
}

enum ActorType {
  visitor
  agent
  system
}

enum OfferMode {
  broadcast
  assigned
  transfer
}

enum OfferStatus {
  pending
  accepted
  declined
  expired
  withdrawn
}

enum MessageVisibility {
  public
  internal
}

enum MessageType {
  text
  attachment
  system
}

enum AttachmentState {
  initiated
  uploading
  uploaded
  scanning
  clean
  rejected
  expired
}

enum RatingValue {
  good
  bad
}

enum ScopeType {
  tenant
  department
  personal
}

enum InvitationState {
  eligible
  displayed
  accepted
  dismissed
  expired
}

enum ConsentPurpose {
  service
  analytics
}

enum ConsentState {
  granted
  denied
  withdrawn
}

enum PageEventKind {
  entered
  left
  visible
  hidden
}

enum TagSource {
  client
  agent
  trigger
  integration
}

enum JobState {
  queued
  running
  succeeded
  failed
  cancelled
}

enum ExportFormat {
  txt
  json
  csv
  pdf
}

enum PrivacyKind {
  access
  erase
}

enum PrivacyState {
  pending_verification
  queued
  running
  completed
  failed
}

enum Plan {
  starter
  team
  business
  enterprise
}

// ─────────────────────────── Global identity ───────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  displayName         String    @map("display_name")
  passwordHash        String?   @map("password_hash")
  avatarUrl           String?   @map("avatar_url")
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(3)
  mfaSecretCiphertext String?   @map("mfa_secret_ciphertext")
  mfaKeyVersion       Int?      @map("mfa_key_version")
  mfaEnabledAt        DateTime? @map("mfa_enabled_at") @db.Timestamptz(3)
  mfaRecoveryHashes   String[]  @default([]) @map("mfa_recovery_hashes")
  /// Last TOTP time step accepted (RFC 6238 §5.2: a code is accepted at most once).
  mfaLastTotpStep     BigInt?   @map("mfa_last_totp_step")
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions       AuthSession[]
  memberships    Membership[]
  oauthAccounts  OAuthAccount[]
  trustedDevices TrustedDevice[]

  @@map("users")
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  csrfTokenHash  String    @map("csrf_token_hash")
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  mfaVerified    Boolean   @default(false) @map("mfa_verified")
  recentAuthAt   DateTime  @default(now()) @map("recent_auth_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  uaSummary      String?   @map("ua_summary")
  ipHash         String?   @map("ip_hash")
  locationLabel  String?   @map("location_label")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  tenantId   String?      @map("tenant_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash")
  payload    Json?
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([userId, purpose])
  @@map("auth_tokens")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model TrustedDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  label      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_devices")
}

/// Outbound mail log; delivery state is tracked separately from acceptance.
model OutboundEmail {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  dedupeKey         String    @unique @map("dedupe_key")
  recipient         String
  subject           String
  textBody          String    @map("text_body")
  htmlBody          String    @map("html_body")
  template          String
  status            String    @default("queued")
  providerMessageId String?   @map("provider_message_id")
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(3)
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("outbound_emails")
}

// ─────────────────────────── Tenancy & team ───────────────────────────

model Tenant {
  id                    String       @id @default(uuid()) @db.Uuid
  slug                  String       @unique
  name                  String
  status                TenantStatus @default(active)
  timezone              String       @default("UTC")
  ownerUserId           String       @map("owner_user_id") @db.Uuid
  retentionDays         Int          @default(180) @map("retention_days")
  settings              Json         @default("{}")
  plan                  Plan         @default(starter)
  chatCounter           Int          @default(0) @map("chat_counter")
  submissionCounter     Int          @default(0) @map("submission_counter")
  onboardingState       Json         @default("{}") @map("onboarding_state")
  onboardingCompletedAt DateTime?    @map("onboarding_completed_at") @db.Timestamptz(3)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version               Int          @default(1)

  @@index([ownerUserId])
  @@map("tenants")
}

model Membership {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  role             Role          @default(agent)
  enabled          Boolean       @default(true)
  desiredStatus    DesiredStatus @default(online) @map("desired_status")
  statusChangedAt  DateTime      @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  capacity         Int           @default(3)
  displayName      String?       @map("display_name")
  title            String?
  preferences      Json          @default("{}")
  lastAssignmentAt DateTime?     @map("last_assignment_at") @db.Timestamptz(3)
  lastSeenAt       DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int           @default(1)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments DepartmentMember[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, enabled, role, id])
  @@index([userId])
  @@map("memberships")
}

model AgentInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  email         String
  role          Role      @default(agent)
  departmentIds String[]  @default([]) @map("department_ids") @db.Uuid
  capacity      Int       @default(3)
  tokenHash     String    @unique @map("token_hash")
  invitedById   String?   @map("invited_by_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version       Int       @default(1)

  @@index([tenantId, email])
  @@map("agent_invitations")
}

model Department {
  id                   String      @id @default(uuid()) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  name                 String
  normalizedName       String      @map("normalized_name")
  publicLabel          String      @map("public_label")
  description          String?
  enabled              Boolean     @default(true)
  scheduleId           String?     @map("schedule_id") @db.Uuid
  routingMode          RoutingMode @default(broadcast) @map("routing_mode")
  queueLimit           Int         @default(1000) @map("queue_limit")
  maxWaitSeconds       Int         @default(300) @map("max_wait_seconds")
  fallbackDepartmentId String?     @map("fallback_department_id") @db.Uuid
  archivedAt           DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version              Int         @default(1)

  members DepartmentMember[]

  @@unique([tenantId, id])
  @@index([tenantId, enabled, id])
  @@index([tenantId, fallbackDepartmentId])
  @@index([tenantId, scheduleId])
  @@map("departments")
}

model DepartmentMember {
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  canServe     Boolean  @default(true) @map("can_serve")
  canMonitor   Boolean  @default(false) @map("can_monitor")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  department Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, departmentId, membershipId])
  @@index([tenantId, membershipId, departmentId])
  @@map("department_members")
}

/// Serialization lock row per agent for capacity checks (ch. 30/31).
model AgentCapacity {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  revision     Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, membershipId])
  @@map("agent_capacity")
}

model AvailabilityInterval {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  status       String
  startedAt    DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(3)
  source       String

  @@index([tenantId, membershipId, startedAt])
  @@map("availability_intervals")
}

model Schedule {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  timezone        String
  weeklyIntervals Json      @map("weekly_intervals")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int       @default(1)

  exceptions ScheduleException[]

  @@unique([tenantId, id])
  @@map("schedules")
}

model ScheduleException {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  localDate  DateTime @map("local_date") @db.Date
  intervals  Json
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  schedule Schedule @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, scheduleId, localDate])
  @@map("schedule_exceptions")
}

model EmergencyClosure {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  siteId       String?   @map("site_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  startsAt     DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(3)
  reason       String
  createdBy    String    @map("created_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, startsAt, endsAt])
  @@index([tenantId, departmentId])
  @@index([tenantId, siteId])
  @@map("emergency_closures")
}

// ─────────────────────────── Sites & widget ───────────────────────────

model Site {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  name                     String
  publicKey                String    @unique @map("public_key")
  previousPublicKey        String?   @unique @map("previous_public_key")
  previousKeyExpiresAt     DateTime? @map("previous_key_expires_at") @db.Timestamptz(3)
  enabled                  Boolean   @default(true)
  configRevision           Int       @default(0) @map("config_revision")
  defaultDepartmentId      String?   @map("default_department_id") @db.Uuid
  scheduleId               String?   @map("schedule_id") @db.Uuid
  timezone                 String?
  identitySecretCiphertext String?   @map("identity_secret_ciphertext")
  identityKeyVersion       Int?      @map("identity_key_version")
  installedAt              DateTime? @map("installed_at") @db.Timestamptz(3)
  lastVerifiedAt           DateTime? @map("last_verified_at") @db.Timestamptz(3)
  lastVerifiedOrigin       String?   @map("last_verified_origin")
  archivedAt               DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                  Int       @default(1)

  origins SiteOrigin[]
  configs WidgetConfigRevision[]

  @@unique([tenantId, id])
  @@index([tenantId, enabled, id])
  @@index([tenantId, defaultDepartmentId])
  @@index([tenantId, scheduleId])
  @@map("sites")
}

model SiteOrigin {
  tenantId    String    @map("tenant_id") @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  origin      String
  patternType String    @default("exact") @map("pattern_type")
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  site Site @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, siteId, origin])
  @@index([tenantId, origin])
  @@map("site_origins")
}

model WidgetConfigRevision {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  revision    Int
  config      Json
  configHash  String    @map("config_hash")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  site Site @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, siteId, revision])
  @@index([tenantId, siteId, publishedAt(sort: Desc)])
  @@map("widget_configs")
}

// ─────────────────────────── Automation ───────────────────────────

model Trigger {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String
  description       String?
  enabled           Boolean   @default(false)
  priority          Int       @default(100)
  eventType         String    @map("event_type")
  currentRevision   Int       @default(1) @map("current_revision")
  publishedRevision Int?      @map("published_revision")
  lastMatchedAt     DateTime? @map("last_matched_at") @db.Timestamptz(3)
  matchCount        Int       @default(0) @map("match_count")
  errorCount        Int       @default(0) @map("error_count")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int       @default(1)

  revisions TriggerRevision[]

  @@unique([tenantId, id])
  @@index([tenantId, eventType, enabled, priority(sort: Desc), id])
  @@map("triggers")
}

model TriggerRevision {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  triggerId   String    @map("trigger_id") @db.Uuid
  revision    Int
  dslVersion  Int       @default(1) @map("dsl_version")
  definition  Json
  publishedBy String?   @map("published_by") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  trigger Trigger @relation(fields: [tenantId, triggerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, triggerId, revision])
  @@map("trigger_revisions")
}

model TriggerRun {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  triggerId        String   @map("trigger_id") @db.Uuid
  triggerRevision  Int      @map("trigger_revision")
  eventId          String   @map("event_id") @db.Uuid
  eventType        String   @map("event_type")
  visitorSessionId String?  @map("visitor_session_id") @db.Uuid
  visitorId        String?  @map("visitor_id") @db.Uuid
  chatId           String?  @map("chat_id") @db.Uuid
  matched          Boolean
  result           Json
  causationId      String?  @map("causation_id") @db.Uuid
  depth            Int      @default(0)
  executedAt       DateTime @default(now()) @map("executed_at") @db.Timestamptz(3)

  @@unique([tenantId, triggerId, triggerRevision, eventId])
  @@unique([tenantId, id], map: "trigger_runs_tenant_id_key")
  @@index([tenantId, triggerId, executedAt(sort: Desc)])
  @@index([tenantId, visitorSessionId, triggerId])
  @@map("trigger_runs")
}

model TriggerEffect {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  actionIndex Int       @map("action_index")
  actionType  String    @map("action_type")
  status      String    @default("pending")
  reason      String?
  executedAt  DateTime? @map("executed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, runId, actionIndex])
  @@map("trigger_effects")
}

model CannedReply {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  scopeType  ScopeType @map("scope_type")
  scopeId    String?   @map("scope_id") @db.Uuid
  scopeKey   String    @map("scope_key")
  slug       String
  title      String
  body       String
  options    String[]  @default([])
  tags       String[]  @default([])
  enabled    Boolean   @default(true)
  usageCount Int       @default(0) @map("usage_count")
  createdBy  String?   @map("created_by") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int       @default(1)

  @@unique([tenantId, scopeKey, slug])
  @@index([tenantId, scopeType, enabled, id])
  @@map("canned_replies")
}

// ─────────────────────────── Visitors ───────────────────────────

model Visitor {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  siteId             String    @map("site_id") @db.Uuid
  anonymousLabel     String    @map("anonymous_label")
  name               String?
  emailCiphertext    String?   @map("email_ciphertext")
  emailLookupHash    String?   @map("email_lookup_hash")
  phoneCiphertext    String?   @map("phone_ciphertext")
  verified           Boolean   @default(false)
  customFields       Json      @default("{}") @map("custom_fields")
  /// Provenance of each custom-field value: { key: { source: visitor|agent|trigger, by, at } } (cleared with the values).
  customFieldSources Json      @default("{}") @map("custom_field_sources")
  notes              String?
