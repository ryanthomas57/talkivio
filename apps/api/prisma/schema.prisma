}

// ─────────────────────────── Optional billing (feature flag BILLING) ───────────────────────────

model BillingAccount {
  tenantId               String    @id @map("tenant_id") @db.Uuid
  providerCustomerId     String?   @unique @map("provider_customer_id")
  state                  String    @default("active")
  plan                   Plan      @default(starter)
  seats                  Int       @default(10)
  providerSubscriptionId String?   @unique @map("provider_subscription_id")
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  graceEndsAt            DateTime? @map("grace_ends_at") @db.Timestamptz(3)
  providerRevision       BigInt    @default(0) @map("provider_revision")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Subscription billing (ch. billing): monthly or yearly, the per-agent monthly price locked at sign-up, and the
  /// plan/seat changes that wait for the next renewal.
  cycle                  String    @default("monthly") @db.VarChar(10)
  unitPriceCents         Int       @default(0) @map("unit_price_cents")
  planNext               Plan?     @map("plan_next")
  cycleNext              String?   @map("cycle_next") @db.VarChar(10)
  seatsNext              Int?      @map("seats_next")
  currentPeriodStart     DateTime? @map("current_period_start") @db.Timestamptz(3)
  /// The gateway's stored-card reference, encrypted at rest; the card number itself never reaches us.
  cardTokenCiphertext    String?   @map("card_token_ciphertext") @db.VarChar(1000)
  cardBrand              String?   @map("card_brand") @db.VarChar(40)
  cardLast4              String?   @map("card_last4") @db.VarChar(4)
  cardExp                String?   @map("card_exp") @db.VarChar(5)
  trialReminderSentAt    DateTime? @map("trial_reminder_sent_at") @db.Timestamptz(3)
  nextAttemptAt          DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  failedAttempts         Int       @default(0) @map("failed_attempts")
  lastError              String?   @map("last_error") @db.VarChar(500)
  canceledAt             DateTime? @map("canceled_at") @db.Timestamptz(3)
  endedAt                DateTime? @map("ended_at") @db.Timestamptz(3)
  /// Set while one worker charges this account, so two never charge it at once.
  chargingUntil          DateTime? @map("charging_until") @db.Timestamptz(3)
  /// A charge whose outcome is unknown (timeout after sending): never retried automatically.
  needsReview            Boolean   @default(false) @map("needs_review")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([state, nextAttemptAt])
  @@map("billing_accounts")
}

/// Every charge attempt, approved or not: the receipts in Settings, Billing and the record for disputes.
model BillingCharge {
  id            String    @id @default(uuid()) @db.Uuid
