{
  "name": "@talkivio/api",
  "version": "0.1.0",
  "private": true,
  "description": "Talkivio API, realtime gateway and background workers",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "node scripts/wait-for-build.mjs && node --watch-path=dist --enable-source-maps dist/worker.js",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/audit-coverage.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:drift": "node scripts/schema-drift.mjs",
    "db:migration:new": "node scripts/schema-drift.mjs --emit",
    "metrics:dictionary": "node scripts/metrics-dictionary.mjs",
    "drill:backup": "node scripts/backup-drill.mjs",
    "prisma:deploy": "node -e \"if(!process.env.DATABASE_OWNER_URL){console.error('Set DATABASE_OWNER_URL (migrations run as the owner role, never the app role)');process.exit(1)}\" && DATABASE_URL=\"$DATABASE_OWNER_URL\" prisma migrate deploy",
    "seed": "node --enable-source-maps dist/seed.js",
    "start:gateway": "node --enable-source-maps dist/gateway.js",
    "contracts": "node scripts/contracts/openapi.mjs && node scripts/contracts/asyncapi.mjs && pnpm --filter @talkivio/client generate && pnpm --filter @talkivio/client build",
    "test:contracts": "node test/contracts.e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@talkivio/contracts": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "dejavu-fonts-ttf": "2.37.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "maxmind": "4.3.29",
    "nodemailer": "10.0.14",
    "otplib": "12.0.1",
    "pdfkit": "0.20.2",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "proxy-addr": "2.0.8",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "stripe": "18.5.0",
    "ua-parser-js": "1.0.41",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@sentry/node": "10.76.2"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.3",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@readme/openapi-parser": "9.1.0",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "@types/ua-parser-js": "0.7.39",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7",
    "yaml": "2.8.1",
    "zod-to-json-schema": "3.24.6"
  }
}
