# Talkivio production settings (deploy/compose.yaml). `scripts/init-env.sh` copies this file to talkivio.env
# (mode 600, git-ignored) and fills every secret marked <generated> with a random value. Fill the rest
# yourself, then run `scripts/check-env.sh`. Never commit talkivio.env.

# ── Your address ──────────────────────────────────────────────────────────────
# Both TALKIVIO_DOMAIN and files.TALKIVIO_DOMAIN need DNS A/AAAA records pointing at this server.
TALKIVIO_DOMAIN=chat.example.com
# When TALKIVIO_DOMAIN is the bare domain (example.com), set www.example.com here so it redirects to it (needs a DNS
# record too: A/AAAA, or a CNAME to the bare domain).
TALKIVIO_WWW_SITE=
# IPv6 visitors keep their real addresses (add AAAA records next to the A records). false only when this server's
# kernel has IPv6 turned off; then publish A records only.
TALKIVIO_IPV6=true
# E-mail for Let's Encrypt (expiry notices). `internal` = private CA, for rehearsals only.
TALKIVIO_TLS=you@example.com
TALKIVIO_BRAND_NAME=Talkivio

# ── Outgoing e-mail (sign-up verification, invitations, password resets, transcripts) ──
# Any SMTP provider: Postmark, Amazon SES, Resend, Mailgun, SendGrid … Verify the sending domain there
# (SPF + DKIM, and a DMARC record) before going live.
TALKIVIO_EMAIL_FROM=Talkivio <no-reply@example.com>
TALKIVIO_SMTP_HOST=smtp.example.com
TALKIVIO_SMTP_PORT=587
TALKIVIO_SMTP_USER=
TALKIVIO_SMTP_PASSWORD=
# true for implicit TLS (port 465); false uses STARTTLS on 587.
TALKIVIO_SMTP_SECURE=false

# ── Off-server backups (scripts/backup.sh) ─────────────────────────────────────
# Any S3-compatible bucket in another provider/region: AWS S3, Cloudflare R2, Backblaze B2, Wasabi …
# Use a key that can only write/read this bucket. Leave empty to keep backups on this server only (not
# recommended: a lost server would lose the backups too).
TALKIVIO_BACKUP_S3_ENDPOINT=
TALKIVIO_BACKUP_S3_BUCKET=
TALKIVIO_BACKUP_S3_ACCESS_KEY=
TALKIVIO_BACKUP_S3_SECRET_KEY=
# Local dumps kept on this server (days).
TALKIVIO_BACKUP_KEEP_DAYS=7

# ── Optional sign-in providers and telemetry ──────────────────────────────────
TALKIVIO_GOOGLE_CLIENT_ID=
TALKIVIO_GOOGLE_CLIENT_SECRET=
TALKIVIO_GITHUB_CLIENT_ID=
TALKIVIO_GITHUB_CLIENT_SECRET=
TALKIVIO_SENTRY_DSN=
TALKIVIO_OTEL_EXPORTER_OTLP_ENDPOINT=
TALKIVIO_LOG_LEVEL=info
# Behind a CDN that adds visitor-location headers (cloudflare, vercel, fastly) name it here; otherwise keep none
# (locations then come from the bundled DB-IP database, and visitors cannot fake their country).
TALKIVIO_GEO_TRUSTED_HEADERS=none

# ── Subscriptions (docs/operations/billing.md) ──────────────────────────────────
# none: nothing is charged and every workspace has every feature. converge: paid plans with a card-required free
# trial, charged through Converge by Elavon (test with CONVERGE_ENV=demo first). Store the PIN with
# scripts/set-secret.sh TALKIVIO_CONVERGE_PIN.
TALKIVIO_BILLING_PROVIDER=none
TALKIVIO_CONVERGE_ENV=demo
TALKIVIO_CONVERGE_MERCHANT_ID=
TALKIVIO_CONVERGE_USER_ID=
TALKIVIO_CONVERGE_PIN=

# ── Images (scripts/deploy.sh reads them from GitHub Container Registry, by digest) ──
TALKIVIO_IMAGE_REPO=ghcr.io/ryanthomas57/talkivio
TALKIVIO_SOURCE_REPO=ryanthomas57/talkivio

# ── Secrets (generated by scripts/init-env.sh; keep a copy in your password manager) ──
# APP_SECRET encrypts stored credentials and signs tokens: losing it invalidates them, so back it up.
TALKIVIO_APP_SECRET=<generated>
TALKIVIO_POSTGRES_PASSWORD=<generated>
TALKIVIO_OWNER_DB_PASSWORD=<generated>
TALKIVIO_APP_DB_PASSWORD=<generated>
TALKIVIO_REDIS_PASSWORD=<generated>
TALKIVIO_MINIO_ROOT_PASSWORD=<generated>
TALKIVIO_S3_APP_SECRET=<generated>
TALKIVIO_METRICS_TOKEN=<generated>
