# docker-mailserver 16.0 settings (no secrets). Reference:
# https://docker-mailserver.github.io/docker-mailserver/v16.0/config/environment/
# The host name, postmaster address and TLS paths come from compose.yaml and mail.env.

LOG_LEVEL=info
TZ=UTC
# Versions are pinned in compose.yaml; upgrades are deliberate.
ENABLE_UPDATE_CHECK=0

# Sending always needs a mailbox login, also from other containers (no trusted Docker networks: no open relay).
PERMIT_DOCKER=none
# A login may only send as its own address or its aliases.
SPOOF_PROTECTION=1
TLS_LEVEL=modern

# Rspamd does spam filtering, DKIM signing, SPF and DMARC checks (it replaces OpenDKIM, OpenDMARC, policyd-spf,
# Amavis and SpamAssassin). It learns from mail moved into or out of Junk.
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
RSPAMD_LEARN=1
RSPAMD_GREYLISTING=0
MOVE_SPAM_TO_JUNK=1
# The Talkivio stack already runs ClamAV for uploads; a second copy here would need another 2-3 GB of memory.
ENABLE_CLAMAV=0

ENABLE_FAIL2BAN=1
POSTSCREEN_ACTION=enforce

ENABLE_IMAP=1
ENABLE_POP3=0
ENABLE_MANAGESIEVE=0
ENABLE_SRS=0

ENABLE_QUOTAS=1
# 25 MB per message, no overall mailbox size limit.
POSTFIX_MESSAGE_SIZE_LIMIT=26214400
POSTFIX_MAILBOX_SIZE_LIMIT=0

# IPv4 only: without IPv6 on the Docker network, IPv6 connections arrive through docker-proxy with an internal
# source address, which would defeat the SPF, DMARC and spam checks. Publish only an A record for the mail host.
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4

LOGROTATE_INTERVAL=weekly
LOGROTATE_COUNT=4
