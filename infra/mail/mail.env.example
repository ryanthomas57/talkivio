# Copied to mail.env (git-ignored) by scripts/init.sh. MAIL_HOSTNAME is the MX host: it needs an A record pointing
# at this server, the reverse DNS (PTR) of the server's IPv4 address set to it, and a Caddy site in deploy/caddy.d/.
MAIL_HOSTNAME=mail.example.com
# Receives delivery reports and DMARC/abuse notices; use an alias of a mailbox you read.
MAIL_POSTMASTER=postmaster@example.com
